// Input Mask
// controls the shape of text entered into an input widget

QLineEdit* phone = new QLineEdit;
phone->setInputMask("999-999-9999");

/**
 * MASK CHARACTERS
 * 
 * A -> [A-Z,a-z] -> character of the lettercategory required
 * a -> character of the letter category permitted but not required
 * 
 * N -> [A-Z,a-z,0-9] -> Character of the letter or number category required
 * n -> not required
 * 
 * X -> any non-blank character requires
 * x -> any non-blank character permited but not required.
 * 
 * 9 -> [0,9] -> Character of the number category
 * required
 * 0 -> Character of the number category permitted not required
 * 
 * D -> [1,9] -> Character of the Number category and larger than zero required
 * d -> permited but not required
 * 
 * # -> Character of the number category, or plus/minus sign permitted but not required
 * 
 * H -> [A-F, a-g, 0-9] -> Hexidecimal character required
 * h -> permitted but not required
 * 
 * B -> [0-1] -> required
 * b -> permitted but not required
 */

 /**
  *  >      :all following alphabetic characters are uppercased
  *  <      :all follwing alphabetic characters are lowercase
  *  !      : Switch of case conversion
  *  ;c     : Terminates the input mask and sets the black character to c
  *  [] {}  :Reserved
  *  \      : Use \ to escape the special characters listed above to use them as seperators
  */


