// QDoubleValidator
// Only allows decimal numbers within a range and a number of decimal places

QLineEdit *priceEdit = new QLineEdit;
QDoubleValidator *validator = new QDoubleValidator(0.0, 9999.99, 2, priceEdit);  // 0 to 9999.99, 2 decimals
validator->setNotation(QDoubleValidator::StandardNotation);  // block scientific notation like 1e5
validator->setLocale(QLocale::c());                          // always use "." as the decimal separator
priceEdit->setValidator(validator);
priceEdit->setPlaceholderText("Price (e.g. 19.99)");
priceEdit->show();




