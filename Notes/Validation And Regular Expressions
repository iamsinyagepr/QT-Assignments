// Regular Expressions
// describes a pattern of characters

/**
 * 
 *  ^       :Begining of string
 *  $       :End of string
 *  .       :Any character except newline by default
 *  *       :Zero or more
 *  +       :One or more
 *  ?       :Zero or more
 *  {n}     :Exactly n repetitions
 *  {n,m}   :Between n and m
 *  [abc]   :Character class
 *  \d      :Digit
 *  \w      :Word character
 *  \s      :Whitespace
 *  \|      :Alternation
 */


// Qt Regular expression validation on input
QRegularExpression regex(
    R"(^[A-Za-z]{3,20}$)"
);

auto* validator =  new QRegularExpressionValidator(regex, nameInput);
nameInput->setValidator(validator);



