// Allows only text that matches a regular expression
QLineEdit *codeEdit = new QLineEdit;

// Example pattern: 3 uppercase letters followed by 4 digits (e.g. COS1511)
QRegularExpression pattern("[A-Z]{3}[0-9]{4}");
codeEdit->setValidator(new QRegularExpressionValidator(pattern, codeEdit));


